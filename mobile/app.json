{
  "expo": {
    "name": "Hivo",
    "slug": "hivo-mobile",
    "scheme": "hivo",
    "version": "0.6.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0d0d0c",
    "ios": {
      "bundleIdentifier": "fr.hivo.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Hivo connects to the Hivo app on your computer over your Wi-Fi to sync your notes, ideas and voice memos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "fr.hivo.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0d0d0c",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "audio/*"
            }
          ]
        },
        {
          "action": "SEND_MULTIPLE",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "audio/*"
            }
          ]
        },
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "application/zip"
            },
            {
              "mimeType": "application/x-zip-compressed"
            }
          ]
        },
        {
          "action": "SEND_MULTIPLE",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "application/zip"
            },
            {
              "mimeType": "application/x-zip-compressed"
            }
          ]
        },
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "text/plain"
            }
          ]
        }
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Hivo uses the camera to scan the pairing QR code shown by the Hivo app on your computer.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Hivo uses the microphone to record voice memos (a flow, a melody) that you send to the Hivo app on your computer.",
          "recordAudioAndroid": true
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "extraProguardRules": "# QR scanning (ML Kit barcode, Google code scanner, expo-camera): the native decoder and Play services reach these by name, so R8 must not rename or strip them.\n-keep class com.google.mlkit.** { *; }\n-keep class com.google.photos.vision.barhopper.** { *; }\n-keep class com.google.android.libraries.barhopper.** { *; }\n-keep class com.google.android.gms.internal.mlkit_vision_barcode.** { *; }\n-keep class com.google.android.gms.internal.mlkit_vision_barcode_bundled.** { *; }\n-keep class com.google.android.gms.internal.mlkit_vision_common.** { *; }\n-keep class com.google.android.gms.internal.mlkit_code_scanner.** { *; }\n-keep class expo.modules.camera.** { *; }\n-keep class expo.modules.hivoshare.** { *; }\n"
          }
        }
      ],
      "expo-font",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0d0d0c"
        }
      ]
    ]
  }
}
