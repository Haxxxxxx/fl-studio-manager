# Crew sharing (optional). Copy to .env.local and fill in.
# Without these, the app works exactly as before, just without crew features.
#
# Local development: run `supabase start`, then copy API_URL and ANON_KEY
# from `supabase status -o env`.
# Production: the EU Supabase project's URL and *anon* (public) key, from
# Project Settings → API. Never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# "Report a bug or send feedback" button in the sidebar (optional): the
# address it writes to. Hidden when empty.
VITE_FEEDBACK_EMAIL=
