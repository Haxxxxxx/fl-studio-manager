{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hivo",
  "version": "0.5.1",
  "identifier": "com.theiaweb.flstudiomanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hivo",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: asset: http://asset.localhost https://i.ytimg.com",
        "media-src": "'self' asset: http://asset.localhost",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost https://chrbpaoljulntuvousnz.supabase.co wss://chrbpaoljulntuvousnz.supabase.co",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "https://www.youtube-nocookie.com"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: asset: http://asset.localhost https://i.ytimg.com",
        "media-src": "'self' asset: http://asset.localhost",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420 http://127.0.0.1:54321 ws://127.0.0.1:54321 https://chrbpaoljulntuvousnz.supabase.co wss://chrbpaoljulntuvousnz.supabase.co",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "https://www.youtube-nocookie.com"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://chrbpaoljulntuvousnz.supabase.co/storage/v1/object/public/releases/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkxN0UzNTAzNEZDQTYwQUIKUldTcllNcFBBelYra2EvWW1NQnB2T0pTQzErRFM4cXNNRlNPUjlUS2puaHRYT2kxZWNQcGtWNTYK"
    }
  }
}
