{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-set-focus",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "updater:default",
    "process:default"
  ]
}
