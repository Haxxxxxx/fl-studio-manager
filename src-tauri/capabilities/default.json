{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "**/*.flp" },
        { "path": "**/*.als" },
        { "path": "**/*.rpp" },
        { "path": "**/*.song" },
        { "path": "**/*.ptx" },
        { "path": "**/*.ptf" },
        { "path": "**/*.cpr" },
        { "path": "**/*.npr" },
        { "path": "**/*.bwproject" }
      ]
    },
    "dialog:default"
  ]
}